rules_version = '2';

// WBPCC — who can read and write what.
//
// 4 access levels (set as a "role" custom claim on the login, by an Admin via the console):
//   Visitor      not signed in. Reads published content. Can send forms, sign petitions,
//                apply to join and ask for an appointment. Never sees any member list.
//   member       + the Members area (resources, own profile).
//   contributor  + creates articles / campaigns / petitions as SUBMISSIONS. A submission is
//                visible only to its author and to Admins until an Admin accepts it.
//   admin        everything: publishes, edits every page, manages people & logins,
//                and is the ONLY role that can see members, applications and form inboxes.
//
// Rules are a wall, not a filter: anything not allowed below is refused.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isAdmin() { return role() == 'admin'; }
    function isContributor() { return role() == 'contributor'; }
    function isMember() { return role() in ['member', 'contributor', 'admin']; }
    function isStaff() { return role() in ['contributor', 'admin']; }

    function isPublished() { return resource.data.get('status', '') == 'published'; }

    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optStr(m, k, max) { return !(k in m) || (m[k] is string && m[k].size() <= max); }
    function stamped(m) { return m.createdAt == request.time; }

    // ---------- public website content ----------
    // Published items are public. Only Admins write (publishing = live).
    // Admins can also keep unpublished drafts here (status "draft" / "hidden").
    function publicCol(col) {
      return col in ['pages', 'leaders', 'districtPresidents', 'groups', 'events',
                     'posts', 'campaigns', 'petitions', 'inspiration', 'offices'];
    }
    match /{col}/{id} {
      allow read: if publicCol(col) && (isPublished() || isAdmin());
      allow write: if publicCol(col) && isAdmin();
    }

    // ---------- members area ----------
    match /resources/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // A member's own private record. Members never see each other.
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['language', 'notify', 'district', 'updatedAt']));
    }

    // ---------- contributor submissions (review queue) ----------
    match /submissions/{id} {
      function mine() { return signedIn() && resource.data.authorUid == request.auth.uid; }
      function valid(d) {
        return d.kind in ['post', 'campaign', 'petition', 'event']
          && d.authorUid == request.auth.uid
          && d.status in ['draft', 'pending']
          && d.title is map;
      }
      allow read: if isAdmin() || (isContributor() && mine());
      allow create: if isStaff() && valid(request.resource.data) && stamped(request.resource.data);
      // Authors may edit their own until it is accepted; they can never accept it themselves.
      allow update: if isAdmin()
        || (isContributor() && mine()
            && resource.data.status in ['draft', 'pending', 'changes']
            && valid(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['reviewedBy', 'reviewedAt', 'reviewNote', 'publishedId']));
      allow delete: if isAdmin() || (isContributor() && mine() && resource.data.status == 'draft');
    }

    // ---------- public forms: anyone can SEND, only Admins can READ ----------
    match /inbox/{id} {
      allow create: if stamped(request.resource.data)
        && request.resource.data.keys().hasOnly(['type', 'email', 'message', 'name', 'phone', 'lang', 'status', 'createdAt'])
        && request.resource.data.type in ['feedback', 'suggestion', 'grievance', 'help', 'volunteer', 'petition', 'media', 'other']
        && str(request.resource.data.email, 200)
        && str(request.resource.data.message, 5000)
        && optStr(request.resource.data, 'name', 120)
        && optStr(request.resource.data, 'phone', 20)
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Appointment with the State President — open to everyone. Only the listed
    // fields are accepted (no ID numbers, no files).
    match /appointments/{id} {
      function d() { return request.resource.data; }
      allow create: if stamped(d())
        && d().keys().hasOnly(['name', 'guardian', 'gender', 'dob', 'occupation', 'phone', 'email', 'whatsapp',
              'address', 'district', 'pin', 'who', 'date', 'time', 'altDate', 'altTime', 'mode', 'people',
              'duration', 'topic', 'reason', 'more', 'updates', 'lang', 'status', 'createdAt'])
        && str(d().name, 120)
        && str(d().phone, 20)
        && str(d().reason, 3000)
        && str(d().date, 10)
        && optStr(d(), 'guardian', 120) && optStr(d(), 'occupation', 120) && optStr(d(), 'email', 200)
        && optStr(d(), 'whatsapp', 20) && optStr(d(), 'address', 400) && optStr(d(), 'district', 80)
        && optStr(d(), 'pin', 10) && optStr(d(), 'who', 120) && optStr(d(), 'topic', 80) && optStr(d(), 'more', 3000)
        && (!('people' in d()) || (d().people is int && d().people >= 1 && d().people <= 10))
        && (!('updates' in d()) || d().updates is bool)
        && d().status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Join form. No Voter ID / Aadhaar, no password, no files — only the listed fields.
    match /applications/{id} {
      function a() { return request.resource.data; }
      allow create: if stamped(a())
        && a().keys().hasOnly(['name', 'guardian', 'gender', 'dob', 'occupation', 'workplace', 'group',
              'mobile', 'mobile2', 'whatsapp', 'email', 'district', 'assembly', 'block', 'ward',
              'address', 'pin', 'lang', 'declarations', 'status', 'fee', 'createdAt'])
        && str(a().name, 120)
        && str(a().mobile, 15)
        && str(a().district, 80)
        && optStr(a(), 'guardian', 120) && optStr(a(), 'occupation', 120) && optStr(a(), 'workplace', 160)
        && optStr(a(), 'group', 60) && optStr(a(), 'mobile2', 15) && optStr(a(), 'whatsapp', 15)
        && optStr(a(), 'email', 200) && optStr(a(), 'assembly', 120) && optStr(a(), 'block', 120)
        && optStr(a(), 'ward', 120) && optStr(a(), 'address', 400) && optStr(a(), 'pin', 10)
        && a().declarations == true
        && a().status == 'pending_payment'
        && a().fee == 5;
      allow read, update, delete: if isAdmin();
    }

    // Petition signatures: anyone signs; names/contacts/addresses are seen only by Admins.
    // The public count on the petition is raised by the server, never by the browser.
    match /petitions/{pid}/signatures/{sid} {
      function s() { return request.resource.data; }
      allow create: if stamped(s())
        && s().keys().hasOnly(['name', 'contact', 'district', 'address', 'showName', 'forGovt', 'lang', 'createdAt'])
        && str(s().name, 120)
        && str(s().contact, 200)
        && str(s().district, 80)
        && optStr(s(), 'address', 400)
        && (!('showName' in s()) || s().showName is bool)
        && (!('forGovt' in s()) || s().forGovt is bool);
      allow read, update, delete: if isAdmin();
    }

    // ---------- team & logs ----------
    match /staff/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Change log: staff add entries about their own actions; nobody edits or deletes.
    match /audit/{id} {
      allow create: if isStaff() && request.resource.data.actorUid == request.auth.uid
        && stamped(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /settings/{id} {
      allow read, write: if isAdmin();
    }
  }
}
